# ─────────────────────────────────────────────────────────────────────────────
# Sangit Shree Prakashan — environment variables
#
# Local dev:  copy this file to `.env.local` and fill in real values.
# Vercel:     add each variable under Settings → Environment Variables and tick
#             EVERY environment it applies to — Production, Preview, AND Development.
#
# ⚠️  NEXT_PUBLIC_* variables are inlined at BUILD time. If they're missing from
#     the Preview scope, PR preview deployments build without them (and the admin
#     panel / checkout can't reach Supabase on the preview URL). Always enable
#     Preview + Development, not just Production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase — REQUIRED (Production, Preview, Development) ────────────────────
# Orders database + admin reads. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Resend — REQUIRED for email (Production, Preview, Development) ────────────
# Order confirmation + admin notification emails. Resend → API Keys.
RESEND_API_KEY=re_your_api_key

# ── Vercel Cron — OPTIONAL (Production only) ─────────────────────────────────
# If set, the daily/weekly digest cron routes require it as a Bearer token.
# Vercel Cron sends it automatically in production. Leave blank to skip the check.
CRON_SECRET=

# ── WhatsApp / Meta Cloud API — OPTIONAL (not yet live) ──────────────────────
# Admin WhatsApp notifications. If unset, WhatsApp sends are silently skipped.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
