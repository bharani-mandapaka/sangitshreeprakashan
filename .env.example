# ─────────────────────────────────────────────────────────────────────────────
# Sangit Shree Prakashan — environment variables
#
# Local dev:  copy this file to `.env.local` and fill in real values.
# Vercel:     add each variable under Settings → Environment Variables and tick
#             EVERY environment it applies to — Production, Preview, AND Development.
#
# ⚠️  NEXT_PUBLIC_* variables are inlined at BUILD time. If they're missing from
#     the Preview scope, PR preview deployments build without them (and the admin
#     panel / checkout can't reach Supabase on the preview URL). Always enable
#     Preview + Development, not just Production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase — REQUIRED (Production, Preview, Development) ────────────────────
# Orders database + customer auth. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase service role — REQUIRED for admin (Production, Preview, Development) ─
# SERVER-ONLY. Do NOT prefix with NEXT_PUBLIC_ — this key bypasses Row Level
# Security entirely, so it must never reach the browser bundle. Used only by
# app/api/admin/* routes to read orders now that orders SELECT is scoped to
# auth.uid() (the admin panel has no Supabase Auth session of its own).
# Supabase → Project Settings → API → service_role key ("secret").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend — REQUIRED for email (Production, Preview, Development) ────────────
# Order confirmation + admin notification emails. Resend → API Keys.
RESEND_API_KEY=re_your_api_key

# ── Admin auth — REQUIRED (Production, Preview, Development) ──────────────────
# SERVER-ONLY. The admin panel password used to be hardcoded in the client
# bundle (app/admin/layout.tsx) — anyone could read it straight out of the JS.
# It's now checked server-side in app/api/admin/login/route.ts, which sets a
# signed httpOnly session cookie; every admin API route verifies that cookie
# instead of trusting anything the browser claims. ADMIN_SESSION_SECRET signs
# that cookie — generate one the same way as PHONE_AUTH_SECRET below (a
# different random value; don't reuse the same secret for two purposes).
ADMIN_PASSWORD=choose-a-real-password
ADMIN_SESSION_SECRET=your-random-secret

# ── Phone auth secret — REQUIRED (Production, Preview, Development) ───────────
# SERVER-ONLY. Used to deterministically derive each phone account's internal
# Supabase password via HMAC — never store or expose this value client-side.
# Any long random string works; generate one with `openssl rand -hex 32`.
PHONE_AUTH_SECRET=your-random-secret

# ── Vercel Cron — OPTIONAL (Production only) ─────────────────────────────────
# If set, the daily/weekly digest cron routes require it as a Bearer token.
# Vercel Cron sends it automatically in production. Leave blank to skip the check.
CRON_SECRET=

# ── WhatsApp / Meta Cloud API — OPTIONAL (not yet live) ──────────────────────
# Admin WhatsApp notifications. If unset, WhatsApp sends are silently skipped.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
